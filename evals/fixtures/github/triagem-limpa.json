{
  "id": "triagem-limpa",
  "description": "Environment ready for J1 (Entry Point A): status ok, no similar open epic (dedup), issue creation recorded.",
  "status": {
    "host": "opencode",
    "platform": {
      "kind": "github",
      "cli": "ok",
      "mcp": "absent",
      "board": "ok",
      "hierarchy": "sub-issues"
    },
    "plugin": "0.1.0"
  },
  "execRoutes": [
    {
      "match": "issue list|search issues",
      "stdout": "[]"
    },
    {
      "match": "issue create",
      "stdout": "https://github.com/acme/loja/issues/50"
    },
    {
      "match": "issue list --assignee",
      "stdout": "[]"
    }
  ]
}
